# Copy this file to .env in this same folder (hw5/.env), then fill in real values.
# The backend reads hw5/.env automatically. Never commit the real .env.

# Portkey gateway — signs the agent's model requests.
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Model the agents use. Only gpt-6-luna is allowed for this homework; the backend
# enforces this and will refuse to start with any other model.
HW5_MODEL=gpt-6-luna
